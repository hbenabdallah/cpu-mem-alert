#!/usr/bin/env python3
# Notification-style popup with a CPU column and a Memory column.
# Usage: cpu-alert-popup CPU% CPU_THRESHOLD CPU_PROCS MEM% MEM_THRESHOLD MEM_PROCS MEM_DETAIL
#   *_PROCS: newline-separated "value<TAB>name" lines
#        cpu-alert-popup --candidates   (only open the list of programs to close)
# Env: CPU_ALERT_CRITICAL (%, default 95), CPU_ALERT_POPUP_TIMEOUT (s, default 15)
import os
import re
import signal
import subprocess
import sys
import time

os.environ.setdefault("GDK_BACKEND", "x11")  # Wayland forbids self-positioning; XWayland allows it

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Gdk

CRITICAL = int(os.environ.get("CPU_ALERT_CRITICAL", 95))
TIMEOUT = int(os.environ.get("CPU_ALERT_POPUP_TIMEOUT", 15))

COLORS = {"ok": "#3d9a50", "warn": "#e08a00", "crit": "#d32f2f"}

CSS = b"""
window { background: #2b2b2b; border-radius: 10px; }
.frame { border: 3px solid @accent; border-radius: 10px; padding: 12px 14px; }
.col { min-width: 210px; }
.title { font-weight: bold; font-size: 11pt; color: #ffffff; }
.value { font-weight: bold; font-size: 20pt; }
.detail { color: #bbbbbb; font-size: 9pt; }
.procs { font-family: monospace; font-size: 9pt; color: #dddddd; }
.sep { background: #555555; min-width: 1px; }
.more { margin-top: 10px; }
"""

# Desktop-session processes that should never be offered for closing.
PROTECTED_PREFIXES = (
    "gnome-shell", "gnome-session", "gnome-keyring", "gsd-", "Xwayland", "mutter", "systemd",
    "dbus-", "pipewire", "wireplumber", "pulseaudio", "ibus-", "at-spi", "xdg-", "gvfs",
    "cpu-alert", "evolution-", "tracker-miner", "FortiClient",
)
CANDIDATE_LIMIT = 15
CLK_TCK = os.sysconf("SC_CLK_TCK")
PAGE_SIZE = os.sysconf("SC_PAGE_SIZE")


def read_proc(pid):
    """Returns (comm, ppid, cpu_ticks, start_ticks, rss_bytes, uid, cmdline) or None if gone."""
    try:
        with open(f"/proc/{pid}/stat") as f:
            stat = f.read()
        with open(f"/proc/{pid}/status") as f:
            uid = next(int(l.split()[1]) for l in f if l.startswith("Uid:"))
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmdline = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
    except (OSError, StopIteration):
        return None
    comm = stat[stat.index("(") + 1:stat.rindex(")")]
    fields = stat[stat.rindex(")") + 2:].split()
    # fields[0] is state (field 3 in proc(5)); utime/stime/starttime/rss are 14/15/22/24
    ticks = int(fields[11]) + int(fields[12])
    return comm, int(fields[1]), ticks, int(fields[19]), int(fields[21]) * PAGE_SIZE, uid, cmdline


def is_protected(comm, cmdline):
    # Scripts show up as their interpreter (bash, python3), so also check the script name
    script = os.path.basename(cmdline.split(" ", 2)[1]) if " " in cmdline else ""
    return comm.startswith(PROTECTED_PREFIXES) or script.startswith(PROTECTED_PREFIXES)


def own_ancestors():
    pids, pid = set(), os.getpid()
    while pid > 1:
        pids.add(pid)
        info = read_proc(pid)
        if not info:
            break
        pid = info[1]
    return pids


def format_age(seconds):
    if seconds >= 86400:
        return f"{seconds // 86400}d {seconds % 86400 // 3600}h"
    if seconds >= 3600:
        return f"{seconds // 3600}h {seconds % 3600 // 60}m"
    return f"{seconds // 60}m"


def list_candidates(sample=0.5):
    """User-owned processes using the most memory + CPU, measured over `sample` seconds."""
    uid, skip = os.getuid(), own_ancestors()
    with open("/proc/meminfo") as f:
        mem_total = int(f.readline().split()[1]) * 1024
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])

    def snapshot():
        procs = {}
        for name in os.listdir("/proc"):
            if name.isdigit() and int(name) not in skip:
                info = read_proc(int(name))
                if info and info[5] == uid and not is_protected(info[0], info[6]):
                    procs[int(name)] = info
        return procs

    before = snapshot()
    time.sleep(sample)
    rows = []
    for pid, (comm, _, ticks, start, rss, _, cmdline) in snapshot().items():
        if pid not in before:
            continue
        cpu = 100 * (ticks - before[pid][2]) / CLK_TCK / sample
        mem = 100 * rss / mem_total
        if rss < 50 * 1024 * 1024 and cpu < 1:
            continue
        age = int(uptime - start / CLK_TCK)
        rows.append({"pid": pid, "name": comm, "cpu": cpu, "rss": rss, "score": cpu + mem,
                     "age": format_age(age), "cmd": cmdline or comm})
    rows.sort(key=lambda r: r["score"], reverse=True)
    rows = rows[:CANDIDATE_LIMIT]
    containers = docker_names()
    for r in rows:
        r["cwd"] = read_cwd(r["pid"])
        r["detail"] = describe(r["name"], r["cmd"], r["cwd"], container_of(r["pid"], containers))
    return rows


def read_cwd(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def docker_names():
    """Maps short container id -> name; empty if docker is missing or not allowed."""
    try:
        out = subprocess.run(["docker", "ps", "--format", "{{.ID}} {{.Names}}"],
                             capture_output=True, text=True, timeout=3).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    return dict(line.split(" ", 1) for line in out.splitlines() if " " in line)


def container_of(pid, containers):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            match = re.search(r"docker[-/]([0-9a-f]{12})", f.read())
    except OSError:
        return ""
    if not match:
        return ""
    return containers.get(match.group(1), match.group(1))


# Chromium/Electron helper processes, keyed by their --type / --utility-sub-type flag
PROCESS_ROLES = {
    "gpu-process": "graphics (GPU)",
    "zygote": "process launcher",
    "network.mojom.NetworkService": "network service",
    "storage.mojom.StorageService": "storage service",
    "audio.mojom.AudioService": "audio service",
}
APP_NAMES = {
    "chrome": "Chrome", "chromium": "Chromium", "claude-desktop": "Claude desktop",
    "code": "VS Code", "slack": "Slack", "discord": "Discord",
}


def describe(comm, cmdline, cwd, container):
    """Human-readable 'what is this process' text for the Details column."""
    home = os.path.expanduser("~")
    project = os.path.basename(cwd) if cwd and cwd.startswith(home + "/") else ""
    in_project = f" · project {project}" if project else ""
    flags = dict(re.findall(r"--(type|utility-sub-type)=(\S+)", cmdline))

    if comm in APP_NAMES:
        app = APP_NAMES[comm]
        kind = flags.get("type")
        if not kind:
            return f"{app} · main process (closing it closes all windows)"
        if kind == "renderer" and "--extension-process" in cmdline:
            return f"{app} · extension"
        if kind == "renderer":
            if comm in ("chrome", "chromium"):
                return f"{app} · tab or site (press Shift+Esc in {app} to see which)"
            return f"{app} · window content"
        role = PROCESS_ROLES.get(flags.get("utility-sub-type", kind), "helper")
        return f"{app} · {role}"
    if comm == "claude":
        source = "Claude Code (from desktop app)" if "claude-code/" in cmdline else "Claude Code session"
        return source + in_project
    if comm == "junie":
        return "JetBrains Junie AI agent" + in_project
    if comm.startswith("embeddings-ser"):
        return "PhpStorm AI semantic search index"
    if comm in ("phpstorm", "idea", "webstorm", "pycharm", "goland"):
        return "JetBrains IDE (all open projects)"

    args = cmdline.split()
    short = " ".join(os.path.basename(a) if "/" in a else a for a in args[:4]) if args else comm
    if container:
        return f"{short} · Docker container {container}"
    return short + in_project


def send_signal(pids, sig):
    sent = 0
    for pid in pids:
        try:
            os.kill(pid, sig)
            sent += 1
        except ProcessLookupError:
            pass
    return sent


class CandidatesWindow(Gtk.Window):
    # ListStore columns
    CHECK, NAME, PID, CPU, MEM, AGE, DETAIL, TOOLTIP = range(8)

    def __init__(self):
        super().__init__(title="Programs to close")
        self.set_default_size(820, 460)
        self.set_keep_above(True)
        self.set_position(Gtk.WindowPosition.CENTER)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        hint = Gtk.Label(xalign=0)
        hint.set_markup("Your heaviest processes right now. <b>Close</b> asks a program to quit; "
                        "<b>Force kill</b> stops it immediately and may lose unsaved work.")
        hint.set_line_wrap(True)
        box.pack_start(hint, False, False, 0)

        self.store = Gtk.ListStore(bool, str, int, str, str, str, str, str)
        view = Gtk.TreeView(model=self.store)
        view.set_tooltip_column(self.TOOLTIP)
        toggle = Gtk.CellRendererToggle()
        toggle.connect("toggled", self.on_toggled)
        view.append_column(Gtk.TreeViewColumn("", toggle, active=self.CHECK))
        for title, col in (("Program", self.NAME), ("PID", self.PID), ("CPU", self.CPU),
                           ("Memory", self.MEM), ("Running", self.AGE), ("Details", self.DETAIL)):
            cell = Gtk.CellRendererText()
            if col == self.DETAIL:
                cell.set_property("ellipsize", 3)  # Pango.EllipsizeMode.END
            column = Gtk.TreeViewColumn(title, cell, text=col)
            column.set_expand(col == self.DETAIL)
            view.append_column(column)
        scroll = Gtk.ScrolledWindow()
        scroll.add(view)
        box.pack_start(scroll, True, True, 0)

        actions = Gtk.Box(spacing=8)
        self.status = Gtk.Label(xalign=0)
        actions.pack_start(self.status, True, True, 0)
        for label, handler in (("Refresh", lambda *_: self.refresh()),
                               ("Force kill", lambda *_: self.close_selected(signal.SIGKILL)),
                               ("Close selected", lambda *_: self.close_selected(signal.SIGTERM))):
            button = Gtk.Button(label=label)
            button.connect("clicked", handler)
            actions.pack_start(button, False, False, 0)
        box.pack_start(actions, False, False, 0)

        self.add(box)
        self.refresh()

    def refresh(self):
        self.store.clear()
        for r in list_candidates():
            tooltip = GLib.markup_escape_text(f"{r['detail']}\n\nFolder: {r['cwd'] or '?'}\n{r['cmd'][:400]}")
            self.store.append([False, r["name"], r["pid"], f"{r['cpu']:.0f}%",
                               f"{r['rss'] / 1024 ** 3:.2f} GiB", r["age"], r["detail"], tooltip])

    def on_toggled(self, _cell, path):
        self.store[path][self.CHECK] = not self.store[path][self.CHECK]

    def close_selected(self, sig):
        pids = [row[self.PID] for row in self.store if row[self.CHECK]]
        if not pids:
            self.status.set_text("Tick the processes to close first.")
            return
        sent = send_signal(pids, sig)
        action = "Force-killed" if sig == signal.SIGKILL else "Asked to close"
        self.status.set_text(f"{action} {sent} process(es).")
        GLib.timeout_add(1500, lambda: self.refresh() and False)


def level(value, threshold):
    if value >= CRITICAL:
        return "crit"
    return "warn" if value >= threshold else "ok"


def column(title, value, threshold, procs, detail):
    lvl = level(value, threshold)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    box.get_style_context().add_class("col")

    head = Gtk.Label(xalign=0)
    head.get_style_context().add_class("title")
    head.set_text(title)
    box.pack_start(head, False, False, 0)

    val = Gtk.Label(xalign=0)
    val.get_style_context().add_class("value")
    val.set_markup(f'<span foreground="{COLORS[lvl]}">{value}%</span>')
    box.pack_start(val, False, False, 0)

    sub = Gtk.Label(xalign=0)
    sub.get_style_context().add_class("detail")
    sub.set_text(detail or f"threshold {threshold}%")
    box.pack_start(sub, False, False, 4)

    lines = []
    for line in procs.splitlines():
        amount, _, name = line.partition("\t")
        lines.append(f"{amount:>7}  {name[:18]}")
    plist = Gtk.Label(xalign=0, yalign=0)
    plist.get_style_context().add_class("procs")
    plist.set_text("\n".join(lines))
    box.pack_start(plist, False, False, 0)
    return box, lvl


def show_candidates():
    win = CandidatesWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()


def main():
    if sys.argv[1:] == ["--candidates"]:
        show_candidates()
        Gtk.main()
        return

    cpu, cpu_thr, cpu_procs, mem, mem_thr, mem_procs, mem_detail = sys.argv[1:8]
    cpu, cpu_thr, mem, mem_thr = int(cpu), int(cpu_thr), int(mem), int(mem_thr)

    cpu_col, cpu_lvl = column("Processor", cpu, cpu_thr, cpu_procs, f"threshold {cpu_thr}%")
    mem_col, mem_lvl = column("Memory", mem, mem_thr, mem_procs, mem_detail)
    worst = max((cpu_lvl, mem_lvl), key=["ok", "warn", "crit"].index)

    provider = Gtk.CssProvider()
    provider.load_from_data(CSS.replace(b"@accent", COLORS[worst].encode()))
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_decorated(False)
    win.set_keep_above(True)
    win.set_accept_focus(False)
    win.set_skip_taskbar_hint(True)
    win.set_skip_pager_hint(True)
    win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)

    columns = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
    columns.pack_start(cpu_col, True, True, 0)
    sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
    sep.get_style_context().add_class("sep")
    columns.pack_start(sep, False, False, 0)
    columns.pack_start(mem_col, True, True, 0)

    def open_candidates(_button):
        GLib.source_remove(timer)
        win.disconnect(quit_handler)
        win.destroy()
        show_candidates()

    more = Gtk.Button(label="Show programs to close")
    more.get_style_context().add_class("more")
    more.connect("clicked", open_candidates)
    frame = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    frame.get_style_context().add_class("frame")
    frame.pack_start(columns, True, True, 0)
    frame.pack_start(more, False, False, 0)

    events = Gtk.EventBox()
    events.add(frame)
    events.connect("button-press-event", lambda *_: Gtk.main_quit())
    win.add(events)
    quit_handler = win.connect("destroy", Gtk.main_quit)

    win.show_all()
    geo = Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)
    area = geo.get_workarea()
    width, _ = win.get_size()
    win.move(area.x + area.width - width - 16, area.y + 16)

    timer = GLib.timeout_add_seconds(TIMEOUT, Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
